    <string name="error_declined_title">Nothing was shared</string>
    <string name="error_declined_body">No problem, nothing was shared.</string>
    <string name="error_expired_title">Request expired</string>
    <string name="error_expired_body">The request timed out.</string>
    <string name="error_wallet_title">Wallet problem</string>
    <string name="error_wallet_body">Your wallet couldn\'t complete the request.</string>
    <string name="error_not_verified_title">Verification failed</string>
