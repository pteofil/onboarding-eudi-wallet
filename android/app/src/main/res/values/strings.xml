    <!-- ===== Final copy from Dana (24 Nov), kept verbatim ===== -->
    <!-- Screen 2: consent -->
    <string name="consent_header">To open your account, we\'ll ask your EUDI Wallet for:</string>
    <string name="consent_identity_title">Your name, date of birth and personal identification number (CNP)</string>
    <string name="consent_identity_body">We need them to confirm who you are, as the law requires for every new account. Your age tells us which packages you can choose, and your CNP lets us check that an income document is really yours.</string>
    <string name="consent_address_title">Your home address</string>
    <string name="consent_address_body">We need it to confirm where you live and to send your card.</string>
    <string name="consent_income_title">Your net monthly income for the last six months (optional)</string>
    <string name="consent_income_body">Share it to check whether you qualify for Plus or Premium. If you don\'t, you can still open an account with Simple or Starter.</string>
    <string name="consent_income_toggle">Share my income to unlock Plus or Premium</string>
    <string name="consent_required">Required</string>
    <string name="consent_optional">Optional</string>
    <string name="consent_footer">You\'ll see exactly what is shared in your wallet before you approve. We don\'t keep your documents, only what\'s needed to open your account. You can stop at any time.</string>
    <string name="consent_why_link">Why do we ask for this?</string>

