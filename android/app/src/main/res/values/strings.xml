    <string name="welcome_title">Welcome to %1$s!</string>
    <string name="welcome_body">Your account is open.</string>
    <string name="welcome_package">Package</string>
    <string name="welcome_iban">IBAN</string>
    <string name="welcome_reference">Reference</string>
    <string name="welcome_already_confirmed">This application has already been confirmed.</string>
    <string name="welcome_done">Done</string>

    <!-- Shared actions -->
    <string name="action_try_again">Try again</string>
    <string name="action_fill_form">Fill in the form</string>
    <string name="action_back_to_start">Back to start</string>

