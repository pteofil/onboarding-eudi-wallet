    <string name="handoff_title">Opening your EUDI Wallet…</string>
    <string name="handoff_body">Check who is asking and which details, then tap Share in your wallet. You will come back here automatically.</string>
    <string name="handoff_not_opened">Didn\'t share, or nothing happened?</string>

